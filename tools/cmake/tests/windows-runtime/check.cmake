cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../../CollectWindowsCrossRuntime.cmake")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${INSPECTOR}")
if(MODE STREQUAL scan_conflict)
  openliero_collect_windows_cross_runtime("${BINARY}" "${WORK};${WORK}/duplicate")
  message(FATAL_ERROR "Expected a conflict to be detected")
endif()

file(MAKE_DIRECTORY "${WORK}")
get_filename_component(leaf_name "${LEAF}" NAME)
string(TOUPPER "${leaf_name}" leaf_name_upper)
string(TOLOWER "${leaf_name}" leaf_name_lower)
get_filename_component(bridge_name "${BRIDGE}" NAME)
file(COPY_FILE "${LEAF}" "${WORK}/${leaf_name_upper}")
file(COPY_FILE "${BRIDGE}" "${WORK}/${bridge_name}")

if(MODE STREQUAL missing)
  file(REMOVE "${WORK}/${leaf_name_upper}")
elseif(MODE STREQUAL conflict)
  file(MAKE_DIRECTORY "${WORK}/duplicate")
  file(COPY_FILE "${LEAF}" "${WORK}/duplicate/${leaf_name_upper}")
  file(APPEND "${WORK}/duplicate/${leaf_name_upper}" "different runtime")
  execute_process(COMMAND "${CMAKE_COMMAND}" -DMODE=scan_conflict
    "-DBINARY=${BINARY}" "-DWORK=${WORK}" "-DINSPECTOR=${INSPECTOR}"
    -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(status EQUAL 0 OR NOT error MATCHES "Conflicting Windows runtime DLL")
    message(FATAL_ERROR "Conflicting runtime was not rejected: ${output}${error}")
  endif()
  return()
endif()

openliero_collect_windows_cross_runtime("${BINARY}" "${WORK}")
if(MODE STREQUAL missing)
  if(NOT _unresolved STREQUAL leaf_name_lower)
    message(FATAL_ERROR "Expected missing ${leaf_name_lower}, got: ${_unresolved}")
  endif()
else()
  list(LENGTH _resolved count)
  if(_unresolved OR NOT count EQUAL 2)
    message(FATAL_ERROR "Expected both dependency DLLs: ${_resolved}; missing: ${_unresolved}")
  endif()
endif()
