# Windows system DLLs are provided by Windows, not by a Linux sysroot. Keep this
# explicit: excluding every DLL absent from the toolchain would hide packaging bugs.
set(_openliero_windows_system_dlls
  advapi32 avrt bcrypt cabinet cfgmgr32 comctl32 comdlg32 crypt32 d2d1 d3d9
  d3d11 d3d12 dbghelp dcomp dinput8 dnsapi dsound dwmapi dxgi dxguid gdi32
  hid imm32 iphlpapi kernel32 ksuser mpr msacm32 msvcrt ncrypt netapi32 normaliz
  ntdll ole32 oleaut32 opengl32 powrprof propsys psapi rpcrt4 secur32 setupapi
  shell32 shlwapi synchronization ucrtbase user32 userenv usp10 uuid uxtheme
  version winhttp wininet winmm winspool wintrust ws2_32 wtsapi32)

function(openliero_collect_windows_cross_runtime executables directories)
  # Index DLLs case-insensitively: Windows import names and on-disk names often
  # differ in case, even though the Linux filesystem is case-sensitive.
  set(names)
  set(files)
  foreach(directory IN LISTS directories)
    file(GLOB entries LIST_DIRECTORIES FALSE "${directory}/*")
    foreach(file IN LISTS entries)
      get_filename_component(name "${file}" NAME)
      string(TOLOWER "${name}" name)
      if(name MATCHES "\\.dll$")
        if(NOT name IN_LIST names)
          list(APPEND names "${name}")
          list(APPEND files "${file}")
        endif()
        string(MD5 key "${name}")
        list(APPEND candidates_${key} "${file}")
      endif()
    endforeach()
  endforeach()

  set(queue ${executables})
  set(visited)
  set(resolved)
  set(unresolved)
  while(queue)
    list(POP_FRONT queue binary)
    if(binary IN_LIST visited)
      continue()
    endif()
    list(APPEND visited "${binary}")
    execute_process(COMMAND "${CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND}" -p "${binary}"
      RESULT_VARIABLE status OUTPUT_VARIABLE imports ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Cannot inspect Windows runtime ${binary}: ${error}")
    endif()
    string(REPLACE "\r" "" imports "${imports}")
    string(REGEX MATCHALL "DLL Name: [^\n]+" imports "${imports}")
    foreach(import IN LISTS imports)
      string(REGEX REPLACE "^DLL Name: " "" name "${import}")
      string(STRIP "${name}" name)
      string(TOLOWER "${name}" name)
      string(REGEX REPLACE "\\.dll$" "" stem "${name}")
      if(name MATCHES "^(api-ms-|ext-ms-)" OR stem IN_LIST _openliero_windows_system_dlls)
        continue()
      endif()
      list(FIND names "${name}" index)
      if(index EQUAL -1)
        list(APPEND unresolved "${name}")
      else()
        list(GET files ${index} library)
        string(MD5 key "${name}")
        file(SHA256 "${library}" expected_hash)
        foreach(candidate IN LISTS candidates_${key})
          file(SHA256 "${candidate}" candidate_hash)
          if(NOT candidate_hash STREQUAL expected_hash)
            message(FATAL_ERROR "Conflicting Windows runtime DLL ${name}: ${library}; ${candidate}")
          endif()
        endforeach()
        get_filename_component(library "${library}" REALPATH)
        list(APPEND resolved "${library}")
        list(APPEND queue "${library}")
      endif()
    endforeach()
  endwhile()
  list(REMOVE_DUPLICATES resolved)
  list(REMOVE_DUPLICATES unresolved)
  set(_resolved "${resolved}" PARENT_SCOPE)
  set(_unresolved "${unresolved}" PARENT_SCOPE)
endfunction()
